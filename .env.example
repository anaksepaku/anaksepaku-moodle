# Contoh konfigurasi. Jangan pernah commit file .env yang sebenarnya.
# Installer akan mengisi nilai acak untuk DB_PASS, DB_ROOT_PASS, ADMIN_PASS.

MOODLE_DIR=/srv/moodle-elearning
MOODLE_WWWROOT=https://elearning.anaksepaku.my.id

WG_BIND_IP=127.0.0.1
WG_PORT=8090
# IP tailscale0 host, kalau mau akses lokal tanpa Cloudflare. Kosongkan jika tidak perlu.
TAILSCALE_IP=

DB_NAME=moodle
DB_USER=moodleuser
DB_PASS=***

DB_ROOT_PASS=***

ADMIN_USER=admin
ADMIN_PASS=***
ADMIN_EMAIL=admin@example.invalid

SITE_NAME="E-Learning Anaksepaku"
SITE_SHORTNAME=EL
MOODLE_LANG=id
MOODLE_TIMEZONE=Asia/Makassar
